{
  "name": "medha-workspace",
  "private": true,
  "type": "module",
  "description": "medha: evidential-memory engine as a library. Four packages (core, store, sync, medha) with enforced boundaries. Self-contained so the whole directory can be extracted to its own repo.",
  "workspaces": [
    "medha-core",
    "medha-store",
    "medha-sync",
    "medha",
    "cli"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs medha-core/src medha-store/src medha-sync/src medha/src cli/src",
    "test": "bun test",
    "spec:check": "python docs/spec/vectors/generate.py --check",
    "check": "bun run lint && bun run typecheck && bun run boundaries && bun run test",
    "build": "bun run tooling/package-release.ts",
    "build:ts": "bun run tooling/package-release.ts",
    "build:rust": "cargo build --release -p medha-cli --bin medha",
    "build:napi": "cargo build --release -p medha-napi",
    "package:rust": "bun run tooling/package-release.ts --rust",
    "smoke": "bun run tooling/smoke-package.ts && bun run tooling/smoke-npm.ts",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "docs:preview": "npm --prefix site run preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "author": {
    "name": "nimishph",
    "url": "https://github.com/nimishph"
  },
  "version": "0.7.1"
}
