dist/
node_modules/
target/
*.node

# Copies of the root files that tooling/package-release.ts stages into cli/ for the npm publish.
# Byte-identical to the originals and never committed; the release workflow re-copies them anyway.
cli/README.md
cli/LICENSE
cli/SKILL.md

# Documentation site (site/). node_modules is covered above; the four generated pages are build
# output produced by site/scripts/, and the VitePress build output is never committed.
site/.vitepress/cache/
site/.vitepress/dist/
site/overview.md
site/agent-skill.md
site/cli.md
site/integrations.md
